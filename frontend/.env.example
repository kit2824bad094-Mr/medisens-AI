# ==========================================
# MediSens AI Frontend Environment Config
# ==========================================

# Backend API URL (Frontend connects to this API)
VITE_API_URL=http://localhost:5000/api

# Supabase Authentication Configuration
# Sign up / open your project at: https://supabase.com
# Find these values in: Supabase Dashboard -> Project Settings -> API
# ⚠️ Only use the PUBLIC ANON key in the frontend. Never put service-role keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
